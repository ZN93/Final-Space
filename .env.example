# Public URL used by CORS and by the deployment smoke test.
APP_BASE_URL=https://final-space.example.com

# The application is bound to loopback; the host reverse proxy exposes HTTPS.
APP_PORT=8080

POSTGRES_DB=finalspace
POSTGRES_USER=finalspace
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE

MONGO_DB=finalspace
MONGO_INITDB_ROOT_USERNAME=finalspace
# Keep this password URL-safe because it is embedded in the MongoDB URI.
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_WITH_A_LONG_URL_SAFE_VALUE

# Generate at least 64 random bytes and keep the value outside version control.
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_64_RANDOM_BYTES
JWT_EXPIRATION=86400000

# Enabled for the first start only. The initializer is idempotent.
APP_BOOTSTRAP_ENABLED=true
APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
APP_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_WITH_A_STRONG_ADMIN_PASSWORD

# MVP setting until database migrations replace automatic schema updates.
SPRING_JPA_HIBERNATE_DDL_AUTO=update
